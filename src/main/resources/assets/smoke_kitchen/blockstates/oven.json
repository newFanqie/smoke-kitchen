{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "heat": "0"
      },
      "apply": {
        "model": "smoke_kitchen:block/oven",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "north",
        "heat": "1|2|3"
      },
      "apply": {
        "model": "smoke_kitchen:block/oven_lit",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "east",
        "heat": "0"
      },
      "apply": {
        "model": "smoke_kitchen:block/oven",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "heat": "1|2|3"
      },
      "apply": {
        "model": "smoke_kitchen:block/oven_lit",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "heat": "0"
      },
      "apply": {
        "model": "smoke_kitchen:block/oven",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "heat": "1|2|3"
      },
      "apply": {
        "model": "smoke_kitchen:block/oven_lit",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "heat": "0"
      },
      "apply": {
        "model": "smoke_kitchen:block/oven",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "heat": "1|2|3"
      },
      "apply": {
        "model": "smoke_kitchen:block/oven_lit",
        "y": 270
      }
    },
    {
      "when": {
        "lid": "true"
      },
      "apply": {
        "model": "smoke_kitchen:block/lid"
      }
    }
  ]
}
