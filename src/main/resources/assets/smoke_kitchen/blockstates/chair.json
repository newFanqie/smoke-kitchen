{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "smoke_kitchen:block/chair",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "smoke_kitchen:block/chair",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "smoke_kitchen:block/chair",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "smoke_kitchen:block/chair",
        "y": 270
      }
    },
    {
      "when": {
        "lid": "true"
      },
      "apply": {
        "model": "smoke_kitchen:block/lid"
      }
    }
  ]
}
