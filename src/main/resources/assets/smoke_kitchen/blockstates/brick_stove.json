{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "smoke_kitchen:block/brick_stove",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "smoke_kitchen:block/brick_stove",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "smoke_kitchen:block/brick_stove",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "smoke_kitchen:block/brick_stove",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "fueled": "true"
      },
      "apply": {
        "model": "smoke_kitchen:block/fuel_bed",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "north",
        "heat": "1|2|3"
      },
      "apply": {
        "model": "smoke_kitchen:block/firebox_lit",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "east",
        "fueled": "true"
      },
      "apply": {
        "model": "smoke_kitchen:block/fuel_bed",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "heat": "1|2|3"
      },
      "apply": {
        "model": "smoke_kitchen:block/firebox_lit",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "fueled": "true"
      },
      "apply": {
        "model": "smoke_kitchen:block/fuel_bed",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "heat": "1|2|3"
      },
      "apply": {
        "model": "smoke_kitchen:block/firebox_lit",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "fueled": "true"
      },
      "apply": {
        "model": "smoke_kitchen:block/fuel_bed",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "heat": "1|2|3"
      },
      "apply": {
        "model": "smoke_kitchen:block/firebox_lit",
        "y": 270
      }
    },
    {
      "when": {
        "contents": "raw"
      },
      "apply": {
        "model": "smoke_kitchen:block/contents_raw"
      }
    },
    {
      "when": {
        "contents": "cooked"
      },
      "apply": {
        "model": "smoke_kitchen:block/contents_cooked"
      }
    },
    {
      "when": {
        "contents": "burnt"
      },
      "apply": {
        "model": "smoke_kitchen:block/contents_burnt"
      }
    },
    {
      "when": {
        "lid": "true"
      },
      "apply": {
        "model": "smoke_kitchen:block/lid"
      }
    }
  ]
}
